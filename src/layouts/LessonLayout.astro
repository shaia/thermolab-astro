---
import BaseLayout from './BaseLayout.astro';
import Capsule from '~/ui/Capsule.astro';
import LessonEnd from '~/ui/LessonEnd';
import { chapterOf, moduleNumber } from '~/course';
import { langOf, ui } from '~/i18n';
import '~/styles/lesson.css';

interface Link {
  href: string;
  id: string;
  title: string;
}
interface Props {
  id: string;
  title: string;
  subtitle?: string;
  minutes: number;
  objectives: { id: string; text: string }[];
  prev: Link | null;
  next: Link | null;
}

const { id, title, subtitle, minutes, objectives, prev, next } = Astro.props;
const lang = langOf(Astro.url.pathname);
const s = ui(lang);
const chapter = chapterOf(id);
const [, n] = id.split('.');
---

<BaseLayout title={`${id} ${title}`} description={subtitle ?? title}>
  <article class="lesson" data-lesson={id}>
    <header class="sheet lesson-head">
      <div>
        <p class="kicker">{s.lesson.kicker(moduleNumber(chapter?.n ?? 0), chapter?.title[lang] ?? '', n)}</p>
        <h1>{title}</h1>
        {subtitle && <p class="lesson-sub">{subtitle}</p>}
        <p class="lesson-meta">
          <span class="chip">{s.lesson.minutes(minutes)}</span>
          <button type="button" class="btn ghost no-print print-btn" onclick="window.print()">{s.lesson.print}</button>
        </p>
      </div>
      <section class="objectives" aria-labelledby="obj-h">
        <h2 id="obj-h">{s.lesson.objectives}</h2>
        <ul>
          {objectives.map((o) => <li data-objective={o.id}>{o.text}</li>)}
        </ul>
      </section>
    </header>

    <slot />

    <footer class="sheet sheet-narrow">
      <LessonEnd client:visible id={id} title={title} lang={lang} />
      <p class="lesson-nav">
        {prev && <a href={prev.href}>{s.nav.backArrow} {prev.id} {prev.title}</a>}
        {next && <a href={next.href}>{next.id} {next.title} {s.nav.fwdArrow}</a>}
      </p>
    </footer>
  </article>
  <Capsule id={id} title={title} prev={prev} next={next} />
</BaseLayout>

<script>
  import { initStepObserver } from '~/ui/steps';
  import { markLesson } from '~/progress/store';
  const id = document.querySelector<HTMLElement>('[data-lesson]')?.dataset.lesson;
  if (id) markLesson(id, 'visited');
  initStepObserver();
</script>

<style>
  .lesson-nav {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin: 18px 0 0;
    font-family: var(--font-ui);
    font-size: 0.95rem;
  }
</style>
