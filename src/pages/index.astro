---
/**
 * The site root: a language chooser. It sends a reader on to the language their browser prefers
 * (Hebrew if it is listed first, English otherwise), and stays a plain page of two links for
 * anyone without JavaScript.
 */
import { url } from '~/lib/url';
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ThermoLab · תרמו-מעבדה</title>
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <script is:inline define:vars={{ en: url('en/'), he: url('he/') }}>
      var first = (navigator.languages && navigator.languages[0]) || navigator.language || '';
      location.replace(/^he\b|^iw\b/i.test(first) ? he : en);
    </script>
  </head>
  <body style="font-family: system-ui, sans-serif; padding: 2rem; background: #fbf7ee; color: #1c2433">
    <p><a href={url('en/')}>ThermoLab, in English</a></p>
    <p lang="he" dir="rtl"><a href={url('he/')}>תרמו-מעבדה, בעברית</a></p>
  </body>
</html>
