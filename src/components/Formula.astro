---
/** A formula card: the result a section has been building to, with a label in the page's language. */
import { tex } from '~/lib/tex';
interface Props {
  tex: string;
  label: string;
}
const { tex: src, label } = Astro.props;
const html = tex(`$$${src}$$`, `<Formula label="${label}">`);
---

<div class="formula-card" data-formula={label}>
  <p class="formula-label">{label}</p>
  <Fragment set:html={html} />
</div>
