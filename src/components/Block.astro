---
/**
 * A lesson section. The kind is the lesson template's vocabulary (enforced by lint-content):
 * hook → predict → explore → explain → example → check → summary.
 */
import { langOf, ui, type BlockKind } from '~/i18n';

interface Props {
  kind: BlockKind;
  title?: string;
  id?: string;
}

const { kind, title, id } = Astro.props;
const lang = langOf(Astro.url.pathname);
---

<section class={`block block-${kind}`} data-block={kind} id={id}>
  <p class="kicker">{ui(lang).block[kind]}</p>
  {title && <h2>{title}</h2>}
  <slot />
</section>
