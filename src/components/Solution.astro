---
/** The worked solution under an <Example>: closed until the student has tried on their own. */
import { langOf, ui } from '~/i18n';
interface Props {
  label?: string;
}
const { label = ui(langOf(Astro.url.pathname)).lesson.solution } = Astro.props;
---

<details class="solution">
  <summary>{label}</summary>
  <div class="solution-body"><slot /></div>
</details>
