---
/**
 * The site header: the brand, the contents link, the language switch and the reader settings.
 * The switch goes to the same page in the other language: every page exists in both.
 */
import { langUrl } from '~/lib/url';
import { langOf, otherLang, swapLang, ui } from '~/i18n';
import Settings from './Settings.tsx';

const path = Astro.url.pathname;
const lang = langOf(path);
const other = otherLang(lang);
const s = ui(lang);
const contents = langUrl(lang);
---

<header class="site-header">
  <a class="brand" href={contents}>
    <span class="brand-mark" aria-hidden="true">
      <svg viewBox="0 0 18 18" width="18" height="18"
        ><rect x="7" y="1.5" width="4" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="1.6" /><circle
          cx="9"
          cy="13.5"
          r="3"
          fill="currentColor"
        /><path d="M9 12.5V6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg
      >
    </span>
    <span>{s.siteName}</span>
  </a>
  <nav aria-label={s.nav.main}>
    <a href={contents} aria-current={path === contents ? 'page' : undefined}>{s.nav.contents}</a>
  </nav>
  <a class="lang-switch" href={swapLang(path, other)} hreflang={other} lang={other} title={ui(other).readIn}>
    {ui(other).langName}
  </a>
  <Settings client:idle lang={lang} />
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    gap: 18px;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 12px var(--gutter);
    font-family: var(--font-ui);
    font-size: 0.92rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    font-size: 1rem;
  }
  .brand-mark {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--hot);
    font-size: 0.95rem;
  }
  nav {
    display: flex;
    gap: 4px;
    flex: 1;
    overflow-x: auto;
    scrollbar-width: none;
  }
  nav a,
  .lang-switch {
    padding: 6px 12px;
    border-radius: 999px;
    color: var(--ink-2);
    text-decoration: none;
    white-space: nowrap;
  }
  nav a:hover,
  .lang-switch:hover {
    background: var(--glass);
    color: var(--ink);
  }
  nav a[aria-current='page'] {
    background: var(--paper);
    color: var(--ink);
  }
  .lang-switch {
    border: 1px solid var(--rule);
  }
  @media (max-width: 720px) {
    .brand span:last-child {
      display: none;
    }
  }
</style>
