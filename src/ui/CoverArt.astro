---
/**
 * The cover: a gas in a box, drawn at build time from the course's own model (src/physics/kinetics.ts).
 * Thirty argon atoms with their velocities, and the bounces they are about to make flashing on the
 * walls: the picture lesson 4.1 starts from. Inline SVG, so it costs no script and follows the theme.
 */
import { ARGON_MASS, initialiseGas, rmsSpeed, uniform } from '~/physics/kinetics';

const W = 520;
const H = 380;
const BOX = { x: 60, y: 30, s: 320 };
const side = 1e-6;
const g = initialiseGas(30, [side, side], 300, ARGON_MASS, uniform(41));
const k = BOX.s / side;
const vScale = (0.16 * BOX.s) / rmsSpeed(300, ARGON_MASS);
const dots = Array.from(g.x, (x, i) => {
  const cx = BOX.x + x * k;
  const cy = BOX.y + BOX.s - g.y[i] * k;
  const ex = cx + g.vx[i] * vScale;
  const ey = cy - g.vy[i] * vScale;
  const len = Math.hypot(ex - cx, ey - cy) || 1;
  const ux = (ex - cx) / len;
  const uy = (ey - cy) / len;
  const head = `M${ex - 7 * ux + 4 * uy},${ey - 7 * uy - 4 * ux}L${ex},${ey}L${ex - 7 * ux - 4 * uy},${ey - 7 * uy + 4 * ux}`;
  return { cx, cy, d: `M${cx},${cy}L${ex},${ey}`, head };
});
// the particles nearest each wall, moving toward it: their bounces flash
const flashes = dots
  .map((d, i) => ({ d, i }))
  .filter(({ i }) => g.x[i] < 0.12 * side && g.vx[i] < 0)
  .concat(dots.map((d, i) => ({ d, i })).filter(({ i }) => g.x[i] > 0.88 * side && g.vx[i] > 0))
  .map(({ i }) => ({ x: g.x[i] < side / 2 ? BOX.x : BOX.x + BOX.s, y: BOX.y + BOX.s - g.y[i] * k }));
// a gauge: the running average settling on the ideal value
const gauge = Array.from({ length: 60 }, (_, j) => {
  const t = j / 59;
  const wobble = Math.sin(j * 1.7) * 0.5 + Math.sin(j * 0.6 + 1) * 0.3;
  const y = 0.5 + (wobble * 0.55) / (1 + 6 * t);
  return `${j ? 'L' : 'M'}${410 + t * 95},${110 + (1 - y) * 120}`;
}).join('');
---

<svg class="cover-art ltr-space" viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true">
  <rect class="box" x={BOX.x} y={BOX.y} width={BOX.s} height={BOX.s} rx="6" />
  <g class="flashes">{flashes.map((f) => <path d={`M${f.x},${f.y - 9}L${f.x},${f.y + 9}`} />)}</g>
  <g class="arrows">{dots.map((d, i) => <g style={`--i:${i}`}><path d={d.d} /><path d={d.head} /></g>)}</g>
  <g class="dots">{dots.map((d, i) => <circle cx={d.cx} cy={d.cy} r="5" style={`--i:${i}`} />)}</g>
  <g class="gauge">
    <path class="axis" d="M410,100V235H510" />
    <path class="ideal" d="M410,170H510" />
    <path class="trace" d={gauge} />
  </g>
</svg>

<style>
  .cover-art {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .box {
    fill: var(--paper-2);
    stroke: var(--ink);
    stroke-width: 2.4;
  }
  .flashes path {
    stroke: var(--hot);
    stroke-width: 4;
    stroke-linecap: round;
  }
  .dots circle {
    fill: var(--ink);
    animation: ink 0.5s ease-out both;
    animation-delay: calc(var(--i) * 40ms);
  }
  .arrows path {
    fill: none;
    stroke: var(--velocity);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .arrows g {
    animation: ink 0.5s ease-out both;
    animation-delay: calc(var(--i) * 40ms + 200ms);
  }
  .gauge path {
    fill: none;
    stroke-linecap: round;
  }
  .gauge .axis {
    stroke: var(--ink-2);
    stroke-width: 1.6;
  }
  .gauge .ideal {
    stroke: var(--hot);
    stroke-width: 1.6;
    stroke-dasharray: 6 5;
  }
  .gauge .trace {
    stroke: var(--cold);
    stroke-width: 2.4;
  }
  @keyframes ink {
    from {
      opacity: 0;
    }
  }
</style>
